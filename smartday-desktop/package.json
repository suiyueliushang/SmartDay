{
  "name": "smartday-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "SmartDay 桌面端：Windows 壁纸日历（托盘常驻 / 点击穿透 / 双样式）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "npm --prefix ../smartday-web run dev",
    "dev": "electron . --dev --open-main",
    "start": "electron . --open-main",
    "smoke": "electron . --smoke",
    "smoke:dev": "electron . --dev --smoke",
    "build:web": "npm --prefix ../smartday-web run build",
    "dist": "npm run build:web && electron-builder --win",
    "make-icons": "node electron/make-icons.cjs",
    "persist:write": "electron . --persist-write",
    "persist:verify": "electron . --persist-verify",
    "diag:lock": "electron . --diag-lock"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.smartday.desktop",
    "productName": "SmartDay",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../smartday-web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SmartDay"
    }
  }
}
